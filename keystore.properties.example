# Copy this file to keystore.properties (never commit the real one; it is gitignored).
# Values are consumed by app/build.gradle.kts and scripts/build-release-aab.ps1.

# Path to the release keystore. Relative paths are resolved from the app/ module
# directory (Gradle's file() uses the module dir), so "../my-release.jks" points
# to the repository root. An absolute path also works.
RELEASE_STORE_FILE=../qbremote-release.jks
RELEASE_STORE_PASSWORD=changeit
RELEASE_KEY_ALIAS=qbremote
RELEASE_KEY_PASSWORD=changeit

# Optional but strongly recommended: SHA256 fingerprint of the release certificate
# (as printed by `keytool -list -v`). scripts/build-release-aab.ps1 refuses to build
# when the actual keystore fingerprint differs, protecting the fixed Play upload key.
RELEASE_KEY_SHA256=AA:BB:CC:...
